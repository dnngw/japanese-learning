{
  "name": "japanlearn",
  "productName": "JapanLearn",
  "version": "0.1.0",
  "private": true,
  "description": "Read first, memorize later: an offline Japanese reading and review app.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run dict:build && npm run licenses:collect && electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "fetch:kana-audio": "node tools/fetch-kana-audio/fetch.mjs",
    "licenses:check": "npx --yes license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;Unlicense;CC0-1.0;BlueOak-1.0.0;Python-2.0;OFL-1.1;MPL-2.0\"",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs",
    "dict:build": "node tools/dict-builder/build.mjs",
    "lint": "eslint .",
    "fetch:kanjivg": "node tools/fetch-kanjivg/fetch.mjs",
    "test:packaged": "electron-vite build && electron-builder --dir -c.electronFuses.enableNodeCliInspectArguments=true && node tests/e2e/smoke.mjs --packaged",
    "licenses:collect": "node tools/collect-licenses.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@open-spaced-repetition/binding": "^0.6.1",
    "@tanstack/react-query": "^5.107.1",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "kuromoji": "^0.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "ts-fsrs": "^6.0.0",
    "wanakana": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "author": "JapanLearn contributors"
}
